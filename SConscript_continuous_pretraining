    )"""


    # If pre_pretraining is enabled, we run it first

if env["RUN_PRE_PRETRAINING"]:
    env["WORK_DIR"] = os.path.join(env["ORIGINAL_WORK_DIR"], "pre_pretraining")
    pre_pretraining_train = training_data["pre_pretraining"]["train"]
