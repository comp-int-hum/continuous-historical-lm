)

data.append(("guttenberg", extracted_structures))


all_train = []
all_dev = []
all_test = []
all_slices = []

for start_data, end_data in env["TIME_SLICES"]:
    start_year = int(start_data)
    end_year = int(end_data)

    trains, devs, tests = [], [], []
    for data_type, data_set in data:
        sample_timerange = env.SampleTime(
            source = data_set,
            target = f"${{WORK_DIR}}/{start_data}_{end_data}/{data_type}.data.jsonl",
            START_YEAR = start_year,
            END_YEAR = end_year,
            **cpu_task_config(env,"SampleTime", "00:30:00", "24GB")
        )
        train, dev, test = env.TrainingSplit(
            source = sample_timerange,
            target = [
                f"${{WORK_DIR}}/{start_data}_{end_data}/{data_type}.data.train.json",
                f"${{WORK_DIR}}/{start_data}_{end_data}/{data_type}.data.dev.json",
                f"${{WORK_DIR}}/{start_data}_{end_data}/{data_type}.data.test.json"
            ],
            TRAIN_PORTION = env["TRAIN_PORTION"],
            DEV_PORTION = env["DEV_PORTION"],
            TEST_PORTION = env["TEST_PORTION"],
            SPLIT_LEVEL = env["SPLIT_LEVEL"],
            SPLIT_STYLE = env["SPLIT_STYLE"],
            RANDOM_SEED = env["RANDOM_SEED"],
            **cpu_task_config(env,"TrainingSplit", "00:30:00", "24GB")
        )
        trains.append(train)
        devs.append(dev)
        tests.append(test)
    
    train, dev, test = env.CollateSplits(
        source = [trains,devs,tests],
        TRAINS = trains,
        DEVS = devs,
        TESTS = tests,
        SHUFFLE = 0,
        SORT = 1,
        target = [  f"${{WORK_DIR}}/{start_data}_{end_data}/data.train", 
                    f"${{WORK_DIR}}/{start_data}_{end_data}/data.dev", 
                    f"${{WORK_DIR}}/{start_data}_{end_data}/data.test"],
        **cpu_task_config(env,"CollateSplits", "00:30:00", "24GB")
    )
    all_train.append(train)
    all_dev.append(dev)
    all_test.append(test)
    all_slices.append((start_data, end_data))


    

generated_data = {
    "train": all_train,
    "dev": all_dev,
    "test": all_test,
    "slices": all_slices
}

Export(
