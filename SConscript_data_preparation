def generate_time_slices():
    mode = env["CATEGORY_MODE"]
    start_year = env["STARTING_YEAR"]
    end_year = env["ENDING_YEAR"]
    time_slices = []

    if mode == "INTERVAL":
        interval = env["SPLIT_INTERVAL"]
    elif mode == "TOTAL":
        total_splits = env["TOTAL_SPLITS"]
        interval = (env["ENDING_YEAR"] - env["STARTING_YEAR"]) // total_splits
    else: 
        raise ValueError("Invalid CATEGORY_MODE. Use 'INTERVAL' or 'TOTAL'.")
    
    for year in range(start_year, end_year + 1, interval):
        time_slices.append((str(year), str(year + interval)))
    
    return time_slices


if len(env["TIME_SLICES"]) == 0:
    env["TIME_SLICES"] = generate_time_slices()


if not env["USE_DATES_FILE"]:
    max_date = max([int(end) for (start, end) in env["TIME_SLICES"]])
    input = env.GenerateQuery(   
        source= None,
        target = "${WORK_DIR}/total/authors.txt", 
        MAX_CUTOFF = max_date,
        **cpu_task_config(env,"GenerateQuery", "00:30:00", "4GB")
    )
    query_res = env.QueryWD(     
        source = input, 
        target = "${WORK_DIR}/total/author_query.jsonl", 
        **cpu_task_config(env,"QueryWD", "00:30:00", "24GB")
    )

    gb_authors = env.GBAuthorFuzzy(
        source = query_res, 
        target = "${WORK_DIR}/total/gb_authors.jsonl", 
        **cpu_task_config(env,"GBAuthorFuzzy", "00:30:00", "24GB")
    )

    if env["USE_INFERENCE"]:
        gb_authors = env.AttributeDates(
            source = gb_authors, 
            target = "${WORK_DIR}/total/gb_authors_dates.jsonl", 
            **gpu_task_config(env,"AttributeDates", "12:30:00", "24GB")
        )
else:
    gb_authors = env.File(env["DATES_FILE"])


