    ca_train_orig = env.File(os.path.join(env["CA_ROOT"], "train.json"))
    ca_test_orig = env.File(os.path.join(env["CA_ROOT"], "test.json"))
    ca_dev_orig = env.File(os.path.join(env["CA_ROOT"], "dev.json"))

generated_data = {}


data = []
env["WORK_DIR"] = env["ORIGINAL_WORK_DIR"]

gb_authors_filtered = env.FilterAndSampleWorks(  
    source = gb_authors, 
    target = "${WORK_DIR}/total/gb_authors_dates_filtered.jsonl",
    WORK_CUTOFF_START = 1750,
    WORK_CUTOFF_END = 1940,
    **cpu_task_config(env,"FilterAndSampleWorks", "00:30:00", "24GB")
)

if env["USE_CA"]:
    ca_slice = env.CollateCA(
        source = [ca_train_orig, ca_test_orig, ca_dev_orig],
        target = "${WORK_DIR}/total/ca_slice.jsonl",
        WORK_CUTOFF_START = 1750,
        WORK_CUTOFF_END = 1940,
        **cpu_task_config(env,"CollateCA", "00:30:00", "24GB")
    )
    data.append(("ca", ca_slice))


gb_authors_sorted = env.ExtractWorks(
    source = gb_authors_filtered,
    target = "${WORK_DIR}/total/gb_authors_sorted.jsonl",
    **cpu_task_config(env,"SortWorks", "00:30:00", "24GB")
)

